# ==============================================================================
# PayFlow Copilot — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the 'backend/' directory:
#      cp .env.example .env
# 2. Update the values with your local or staging credentials.
# 3. NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Application Settings
APP_NAME="PayFlow Copilot"
APP_ENV="development"
DEBUG=true

# Database Configuration (PostgreSQL with async psycopg 3 driver)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/payflow_copilot"

# Security & Authentication
# In production, generate a cryptographically strong key: openssl rand -hex 32
SECRET_KEY="dev-insecure-secret-key-change-in-production-payflow-copilot-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5
CHAT_RATE_LIMIT=30
DOCUMENT_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# Razorpay Standard Checkout
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# External AI Provider API Keys
# Required for PayFlow Copilot AI policy assistance, explanation, and dispute drafting
GEMINI_API_KEY=""
GROQ_API_KEY=""
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_RETRIES=2
EVALUATION_PROVIDER="groq"

# Allowed CORS Origins (comma-separated or JSON list of URLs)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Qdrant Cloud (Phase 3)
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="payflow_knowledge"

# Embeddings (use the same provider/model for ingestion and retrieval)
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_MAX_FILE_SIZE_BYTES=10485760
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_CHUNK_OVERLAP=180

# LLM settings reserved for Phase 4; no LLM calls are made in Phase 3
LLM_PROVIDER="groq"
LLM_MODEL="openai/gpt-oss-120b"
LLM_API_KEY=""
KNOWLEDGE_SIMILARITY_THRESHOLD=0.0
